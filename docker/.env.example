# ============================================
# VoxAudit 语音管理系统 · 环境配置示例
# ============================================
# 复制此文件为 .env 后填入实际值
# ============================================

# ------------------
# App Settings
# ------------------
APP_NAME="VoxAudit 语音管理系统"
APP_VERSION="1.1.0"
DEBUG=false
TZ=Asia/Shanghai
PYTHONPATH=/workspace

# ------------------
# Database
# ------------------
DB_HOST=mysql
DB_PORT=3306
DB_USER=voxaudit_admin
DB_PASSWORD=<your_db_password>
DB_NAME=voxaudit_db
MYSQL_ROOT_PASSWORD=<your_mysql_root_password>

# ------------------
# MinIO / OSS
# ------------------
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

OSS_ENDPOINT=http://localhost:9000
OSS_ACCESS_KEY=<your_minio_access_key>
OSS_SECRET_KEY=<your_minio_secret_key>
OSS_BUCKET=voxaudit-recordings
OSS_SECURE=false

# ------------------
# Admin Login
# ------------------
ADMIN_USER=admin
ADMIN_PASSWORD=<your_admin_password>

# ------------------
# K-prefix Local Login
# ------------------
# loginid 以 k 开头的账号使用此默认密码登录；首次登录后强制改密
K_USER_DEFAULT_PASSWORD=kefu123456
# k 账号改密后多少天再次强制改密（默认 90 = 三个月）
K_USER_PASSWORD_EXPIRE_DAYS=90

# ------------------
# OA Configuration
# ------------------
OA_BASE_URL=<your_oa_base_url>
OA_SECRET_KEY=<your_oa_secret_key>
OA_API_IDENTIFIER=<your_oa_api_identifier>
OA_TOKEN_EXPIRE_MINUTES=5
OA_TIME_OFFSET_SECONDS=0

# ------------------
# Ports
# ------------------
FRONTEND_EXTERNAL_PORT=8888
BACKEND_EXTERNAL_PORT=8000

# ------------------
# CORS
# ------------------
CORS_ORIGINS=http://localhost:8888,http://localhost:3000

# ------------------
# Batch Retry Concurrency (Per User)
# ------------------
MAX_RETRY_CONCURRENCY=5
MAX_LLM_CONCURRENCY=3

# ------------------
# Batch Retry Concurrency (Global)
# ------------------
MAX_GLOBAL_ASR_CONCURRENCY=20
MAX_GLOBAL_LLM_CONCURRENCY=10