# ============================================
# VoxAudit 语音管理系统 · 环境配置示例
# ============================================
# 复制此文件为 .env 后填入实际值
# ============================================

# ------------------
# App Settings
# ------------------
APP_NAME="VoxAudit 语音管理系统"
APP_VERSION="1.3.0"
DEBUG=false
TZ=Asia/Shanghai
PYTHONPATH=/workspace

# ------------------
# Image Tag
# 改代码后必须 bump 这个 tag，再执行 docker compose up -d --build，
# 否则 compose 会复用本地同名旧镜像，代码不生效（却看不出来）
# ------------------
IMAGE_TAG=20261023

# ------------------
# Database
# ------------------
DB_HOST=mysql
DB_PORT=3306
DB_USER=voxaudit_admin
DB_PASSWORD=<your_db_password>
DB_NAME=voxaudit_db
MYSQL_ROOT_PASSWORD=<your_mysql_root_password>

# ------------------
# MinIO / OSS
# ------------------
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

OSS_ENDPOINT=http://localhost:9000
OSS_ACCESS_KEY=<your_minio_access_key>
OSS_SECRET_KEY=<your_minio_secret_key>
OSS_BUCKET=voxaudit-recordings
OSS_SECURE=false

# ------------------
# Admin Login
# ------------------
ADMIN_USER=admin
ADMIN_PASSWORD=<your_admin_password>

# ------------------
# K-prefix Local Login
# ------------------
# loginid 以 k 开头的账号使用此默认密码登录；首次登录后强制改密
K_USER_DEFAULT_PASSWORD=kefu123456
# k 账号改密后多少天再次强制改密（默认 90 = 三个月）
K_USER_PASSWORD_EXPIRE_DAYS=90

# ------------------
# 上游 CSP 适配器 + ICP 链路（催记管理数据源）
# 链路：generate_mac → ESCTerminal 查询 → verify_mac（校验查询响应）→ 逐条 decrypt
# CSP_ADAPTER_BASE_URL：MAC / verify / decrypt 的统一网关，形如 http://csp-adapter:8081
# ICP_API_BASE_URL：真正的 ICP1100010 业务系统完整 URL（**含 /v1/icp/ICP1100010 路径**）
#                     示例 http://escterminal:10306/v1/icp/ICP1100010
# ICP_API_TIMEOUT：ESCTerminal 查询超时秒数
# ------------------
CSP_ADAPTER_BASE_URL=<your_csp_adapter_url>
CSP_ADAPTER_TIMEOUT=10
ICP_API_BASE_URL=<your_escterminal_url>/v1/icp/ICP1100010
ICP_API_TIMEOUT=15

# —— 链路上行固定标识（不同环境可改）——
# CSP_KEY_NAME：解密录音地址用的密钥名
CSP_KEY_NAME=GZYH.LMDA_node.zek
# X_CSP_GLOBAL_SERVICE_NO：同一逻辑请求的所有 HTTP 调用共享
X_CSP_GLOBAL_SERVICE_NO=G202610130000000001
# X_CSP_SOURCE_JOURNAL_NO：同一逻辑请求共享；留空则每次刷新自动生成
#                         （DEMO{yyyyMMdd}{9 位毫秒序号}）
X_CSP_SOURCE_JOURNAL_NO=
# 节点名：generate 调 ICPA 侧、verify 调 LMDA 侧
X_CSP_NODE_NAME_GENERATE=ICPA
X_CSP_NODE_NAME_VERIFY=LMDA
# GZB 流向：我们是 LMD 侧，调用 ICP 侧
X_GZB_SOURCE_SYSTEM_CODE=LMD
X_GZB_SINK_SYSTEM_CODE=ICP
X_GZB_ACTION_ID=ICP1100010
X_GZB_MAC_ENCRYPT_TYPE=4

# —— 催记刷新窗口（点击"刷新"时自动取 [明天00:00 - N天, 明天00:00)）——
# N=1 → 只覆盖「今天」；N=2 → 覆盖「昨天 + 今天」（推荐，避免隔天没刷新时漏掉昨天的通话）
RECORDING_REQUEST_DURATION_DAYS=2

# ------------------
# OA Configuration
# ------------------
OA_BASE_URL=<your_oa_base_url>
OA_SECRET_KEY=<your_oa_secret_key>
OA_API_IDENTIFIER=<your_oa_api_identifier>
OA_TOKEN_EXPIRE_MINUTES=5
OA_TIME_OFFSET_SECONDS=0

# ------------------
# Ports
# ------------------
FRONTEND_EXTERNAL_PORT=8888
BACKEND_EXTERNAL_PORT=8000

# ------------------
# CORS
# ------------------
CORS_ORIGINS=http://localhost:8888,http://localhost:3000

# ------------------
# Batch Retry Concurrency (Per User)
# ------------------
MAX_RETRY_CONCURRENCY=5
MAX_LLM_CONCURRENCY=3

# ------------------
# Batch Retry Concurrency (Global)
# ------------------
MAX_GLOBAL_ASR_CONCURRENCY=20
MAX_GLOBAL_LLM_CONCURRENCY=10

# ------------------
# 催记管理 - 后台处理并发数
# COLLECTION_NOTE_PROCESS_CONCURRENCY: 后台一次认领多少条 call_notes 同时处理（ASR+LLM）
# COLLECTION_NOTE_STUCK_MINUTES: processing 状态超过该分钟数视为崩溃，重置为 pending
# ------------------
COLLECTION_NOTE_PROCESS_CONCURRENCY=3
COLLECTION_NOTE_STUCK_MINUTES=10

# ------------------
# 催记管理 - 刷新频控
# COLLECTION_NOTE_REFRESH_COOLDOWN_SECONDS: 同一 loginid 在此秒数内只允许点一次刷新；<=0 关闭
# ------------------
COLLECTION_NOTE_REFRESH_COOLDOWN_SECONDS=5